+        r = by_index.get(b[u"index"])
+        mismatch = r is None or r[u"name"] != n or r[u"parent"] != (
+            -1 if b[u"parent"] is None else bones[b[u"parent"]][u"index"] if b[u"parent"] in bones else -2)
+    if mismatch:
