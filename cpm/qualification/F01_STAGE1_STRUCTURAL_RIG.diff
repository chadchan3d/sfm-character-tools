+def prod_body_rig_validate(record):
+    """The adapter record's own consistency (after the closed schema): its rule, the normalized rig name, no passive
+    bones, exactly one placement handle, and exclusions that are exactly the preserved FK bones."""
+    pose = record[u"pose"]
+    region = pose[u"regions"][PROD_BODY_REGION]
