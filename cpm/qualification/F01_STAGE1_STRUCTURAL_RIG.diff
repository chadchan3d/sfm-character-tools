+# --- part 4: F-01 Stage 1, generic structural rig support -----------------------------------------------------------
+# Astra's compatibility adjudication (ACCEPT WITH CONDITIONS), F-01 Blueprint R4 and the Owner's Stage 1 assignment
+# ("F-01 - Stage 1: Generic Structural Rig Support", 2026-11-18; F01_BROAD_FULL_BODY_COMPATIBILITY_REVIEW.md Option 1
+# with Option 3). A rigged character without a registry profile gets its rig description drafted from the selected
+# live instance by fixed structural rules (prod_body_rig_draft). No name decides a role and no character is listed.
+# Each role is established on its own before it is admitted: the placement handle by its point and orient constraint
+# of the model transform; helper handles as followers of one bone; core handles by their own control channels; a
+# pole's orientation is kept only on a leaf handle that is nothing but an IK pole; constraints are single-target,
+# weight 1, with two-bone IK chains. The draft then passes the registry's own structural rules and the unchanged stage
+# E classifier, descriptor (the rig name normalized to its structure), planner, P1-P7 transaction and P7 skeleton
+# verification. Fox (rig_biped_simple) is the initial qualification fixture, not a supported character.
+# Records are version 2 with an explicit adapter marker in place of the registry profile set: older readers refuse
+# them as unreadable, and saved metadata never authorizes a write (the destination's own draft does, and the saved
+# descriptor must equal it exactly). Experimental: the qualification build only, until natively qualified.
+# Outside Stage 1 (refused): control-less bones (jiggle: Stage 2; procedural helpers), weighted or multiple-target
+# constraints, other operator types, reverse feet, handles parented to bones and cross-model retargeting.
+
+PROD_BODY_RIG_RULE = u"structural_rig_v1"
+PROD_BODY_RIG_REVISION = 1
+# experimental: usable in the qualification build only; production keeps the RC2 refusal of rigged characters
+# without a registry profile until the Owner accepts the native Fox qualification.
+PROD_BODY_RIG_STATUS = u"experimental"
+PROD_BODY_RIG_AUTH_SCHEMA = u"cpm-structural-rig-authorization-v1"
+PROD_BODY_RIG_NAME = u"@structural"           # the descriptor's rig name: never the instance's rig_biped_<animset>
+PROD_BODY_RIG_EXCLUSION_PROVENANCE = (u"user_confirmed",)
+PROD_BODY_RIG_MAX_EXCLUSIONS = 16
+PROD_BODY_RIG_POINT = u"DmeRigPointConstraintOperator"
+PROD_BODY_RIG_ORIENT = u"DmeRigOrientConstraintOperator"
+PROD_BODY_RIG_IK = u"DmeRigIKConstraintOperator"
+PROD_BODY_RIG_PROFILE_KEYS = (u"region", u"rig_name", u"placement_handle", u"handles", u"helper_handles",
+                              u"written_handle_channels", u"preserved_handle_channels", u"constraints",
+                              u"preserved_fk_bones", u"passive_channel_bones", u"tolerances")
+
+
+def prod_body_rig_usable(mode, rule=PROD_BODY_RIG_RULE, revision=PROD_BODY_RIG_REVISION):
+    """Whether the structural rig adapter is usable in this build mode (experimental: qualification only)."""
+    if rule != PROD_BODY_RIG_RULE or revision != PROD_BODY_RIG_REVISION:
+        return False
+    if mode == u"qualification":
+        return True
+    return mode == u"production" and PROD_BODY_RIG_STATUS == u"qualified"
+
+
+def prod_body_rig_is_record(record):
+    """A version 2 record of the structural rig adapter (an explicit adapter marker, never a registry profile)."""
+    return prod_body_is_record(record) and isinstance(record[u"pose"].get(u"adapter"), dict)
+
+
+def prod_body_rig_exclusions(exclusions):
+    """The artist-confirmed face exclusions of the Save dialog's review (the v3 Full body review, reused), normalized.
+    They only ever remove bones from the written set."""
+    out, ids = [], set()
+    for e in exclusions or []:
+        if not isinstance(e, dict) or e.get(u"provenance") not in PROD_BODY_RIG_EXCLUSION_PROVENANCE:
+            raise prod_body_error(u"structure-unsupported", u"an exclusion is not confirmed by the artist")
+        bones = e.get(u"bones")
+        if not isinstance(bones, list) or not bones or not all(
+                isinstance(b, prod_pose_text_types()) and 0 < len(b) <= 256 for b in bones):
+            raise prod_body_error(u"structure-unsupported", u"an exclusion names no bones")
+        ident = e.get(u"id") or u"face"
+        label = e.get(u"label") or u"Face"
+        if ident in ids or not isinstance(ident, prod_pose_text_types()) or not isinstance(
+                label, prod_pose_text_types()):
+            raise prod_body_error(u"structure-unsupported", u"exclusion %r is invalid or repeated" % (ident,))
+        ids.add(ident)
+        out.append({u"id": ident, u"bones": sorted(set(bones)), u"provenance": e[u"provenance"], u"label": label})
+    if len(out) > PROD_BODY_RIG_MAX_EXCLUSIONS:
+        raise prod_body_error(u"structure-unsupported", u"too many exclusions")
+    return out
+
+
+def prod_body_rig_check(profile):
+    """The drafted description must pass every structural rule of a registry profile (prod_body_registry_parse, on a
+    one-profile document): schema, hierarchy, helpers, channels, constraint slots and duplicates, tolerances."""
+    doc = {u"format": PROD_BODY_REGISTRY_FORMAT, u"version": 1, u"rig_classes": {}, u"mappings": [],
+           u"profiles": {PROD_BODY_RIG_RULE: dict((k, profile[k]) for k in PROD_BODY_RIG_PROFILE_KEYS)}}
+    raw = prod_pose_canonical_bytes(doc)
+    try:
+        prod_body_registry_parse(raw, hashlib.sha256(raw).hexdigest())
+    except ProdPoseError as exc:
+        raise prod_body_error(u"structure-unsupported", u"the drafted rig description is refused: %s" % exc)
+
+
+def prod_body_rig_draft(D, exclusions=None):
+    """Stage 1: the rig description of one discovered instance (prod_body_discover's form), from structure alone, in
+    the registry profile form plus the adapter's own fields. Refuses (ProdPoseError, detail logged) whenever a role
+    cannot be established or the rig is outside Stage 1."""
+    fail = prod_body_error
+    rig, handles, bones = D[u"rig"], D[u"rig"][u"handles"], D[u"bones"]
+    exclusions = prod_body_rig_exclusions(exclusions)
+    # 1. The rig: exactly one registration of this instance.
+    if rig[u"registrations"] != 1 or len(rig[u"names"]) != 1 or not rig[u"names"][0] or not handles:
+        raise fail(u"unavailable", u"rig registrations %r (%d), %d handles" % (rig[u"names"], rig[u"registrations"],
