+def prod_body_rig_availability(record, identity, mode):
+    """Stage 1 (C1): offline availability of a structural rig record for the selected character, for the Poses page
+    and Pose Info (the scene is read only at Apply): the adapter rule is usable in this build and the saved model is
+    the selected model. An available button authorizes nothing: Apply drafts the destination independently and
+    compares it exactly, then P2-P7."""
+    adapter = record[u"pose"].get(u"adapter") or {}
+    if not prod_body_rig_usable(mode, adapter.get(u"rule"), adapter.get(u"revision")):
+        return u"not-qualified"
+    if identity is None or prod_pose_model_key(u(identity.get("model") or u"")) !=             prod_pose_model_key(record[u"pose"][u"source"][u"model_ref"]):
+        return u"different-model"
+    return u"available"
+
